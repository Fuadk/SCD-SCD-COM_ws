{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    
    "starlib": {
      "projectType": "library",
      "root": "projects/starlib",
      "sourceRoot": "projects/starlib/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/starlib/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/starlib/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/starlib/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/starlib/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    },
    "SCD-SCD-COM": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "standalone": false
        },
        "@schematics/angular:directive": {
          "standalone": false
        },
        "@schematics/angular:pipe": {
          "standalone": false
        }
      },
      "root": "projects/SCD-SCD-COM",
      "sourceRoot": "projects/SCD-SCD-COM/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
             "outputHashing": "all",
            "optimization": true,
            "extractLicenses": true,
            "namedChunks": false,
            "aot": true,
            "allowedCommonJsDependencies": [
              "@progress/kendo-date-math",
              "@progress/kendo-angular-common",
              "ts-md5/dist/md5",
              "crypto-js",
              "js-sha256",
              "qrcode",
              "@swimlane/dragula"
            ],
            "outputPath": "dist/SCD-SCD-COM",
            "index": "projects/SCD-SCD-COM/src/index.html",
            "browser": "projects/SCD-SCD-COM/src/main.ts",
            "polyfills": [
              "zone.js",
              "projects/SCD-SCD-COM/src/polyfills.js",
              "@angular/localize/init"
            ],

            "tsConfig": "projects/SCD-SCD-COM/tsconfig.app.json",
            "assets": [
              "projects/SCD-SCD-COM/src/favicon.ico",
              "projects/SCD-SCD-COM/src/assets",
              {
                "glob": "**/*",
                "input": "projects/SCD-SCD-COM/public"
              },
              {
                "glob": "*",
                "input": "projects/SCD-SCD-COM/src/assets/pwa",
                "output": "/"
              },
              {
                "glob": "**/*.svg",
                "input": "node_modules/@siemens/ix-icons/svg",
                "output": "/assets/siemens-icons"
              },
              {
                "glob": "**/*.svg",
                "input": "node_modules/@flaticon/flaticon-uicons/svg/regular",
                "output": "/assets/flaticon-icons"
              },
              {
                "glob": "**/*.svg",
                "input": "node_modules/@flaticon/flaticon-uicons/svg/solid",
                "output": "/assets/flaticon-icons-solid"
              },
              {
                "glob": "*.png",
                "input": "projects/SCD-SCD-COM/src/assets/icons",
                "output": "/icons"
              },
              {
                "glob": "**/*",
                "input": "projects/SCD-SCD-COM/src/assets/icons",
                "output": "/icons"
              },
              {
                "glob": "**/*",
                "input": "projects/SCD-SCD-COM/src/assets/screenshots",
                "output": "/screenshots"
              },
              {
              "glob": "**/*.svg",
              "input": "projects/SCD-SCD-COM/src/assets/svgrepo-icons",
              "output": "/assets/svgrepo-icons"
            },
              "projects/SCD-SCD-COM/src/manifest.json"
            ],
            "styles": [
              "styles.scss",
              "node_modules/bpmn-js/dist/assets/diagram-js.css",
              "node_modules/bpmn-js/dist/assets/bpmn-font/css/bpmn.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "optimization": true,
              "extractLicenses": true,
              "sourceMap": false,
               "outputHashing": "all",
              "namedChunks": false,
              "aot": true,
              "fileReplacements": [
                {
                  "replace": "projects/SCD-SCD-COM/src/environments/environment.ts",
                  "with": "projects/SCD-SCD-COM/src/environments/environment.prod.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "20mb",
                  "maximumError": "40mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kB",
                  "maximumError": "10kB"
                }
              ]
            },
            "stage": {
              "optimization": true,
              "extractLicenses": false,
              "namedChunks": true,
              "sourceMap": false,
              "aot": true,
              "fileReplacements": [
                {
                  "replace": "projects/SCD-SCD-COM/src/environments/environment.ts",
                  "with": "projects/SCD-SCD-COM/src/environments/environment.stage.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "SCD-SCD-COM:build:production"
            },
            "development": {
              "buildTarget": "SCD-SCD-COM:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "projects/SCD-SCD-COM/src/polyfills.js",
              "@angular/localize/init"
            ],
            "tsConfig": "projects/SCD-SCD-COM/tsconfig.spec.json",
            "assets": [
              "projects/SCD-SCD-COM/src/favicon.ico",
              "projects/SCD-SCD-COM/src/assets",
              {
                "glob": "**/*",
                "input": "projects/SCD-SCD-COM/public"
              }
            ],
            "styles": [
              {
                "input": "node_modules/@progress/kendo-font-icons/dist/index.css"
              },
              "styles.scss",
              "node_modules/bpmn-js/dist/assets/diagram-js.css",
              "node_modules/bpmn-js/dist/assets/bpmn-font/css/bpmn.css"

            ],
            "scripts": []
          }
        }
      }
    }
   
    
  },
  "cli": {
    "analytics": "7c61b82a-d19f-4431-8d36-198c6b193fda"
  }
}